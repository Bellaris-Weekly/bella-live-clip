{
  "name": "bella-live-clip",
  "version": "2.11.7",
  "private": true,
  "type": "module",
  "description": "Bilibili submission, live and replay clip downloader userscript",
  "scripts": {
    "build": "node tools/scripts/build.mjs",
    "test": "node --test tools/tests/unit/*.test.mjs",
    "serve": "node tools/scripts/dev-server.mjs",
    "check": "node --check bella-live-clip.user.js",
    "verify": "npm run build && npm run check && npm run check:version && npm test",
    "check:version": "node tools/scripts/check-version.mjs"
  },
  "dependencies": {
    "hls.js": "1.6.16",
    "mediabunny": "1.56.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bellaris-Weekly/bella-live-clip.git"
  }
}
