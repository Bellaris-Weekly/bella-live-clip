{
  "name": "bella-live-clip",
  "version": "2.14.1",
  "private": true,
  "type": "module",
  "description": "Bilibili submission, live and replay clip downloader userscript",
  "scripts": {
    "build": "node tools/scripts/build.mjs",
    "build:preview": "node tools/scripts/build.mjs --preview",
    "build:all": "npm run build && npm run build:preview",
    "test": "node --test --test-concurrency=4 --test-reporter=dot tools/tests/unit/*.test.mjs",
    "serve": "node tools/scripts/dev-server.mjs",
    "verify": "npm run lint && npm run build:all && npm run check:version && npm test",
    "release": "node tools/scripts/release.mjs",
    "check:version": "node tools/scripts/check-version.mjs",
    "logs:deploy": "node tools/scripts/deploy-log-service.mjs",
    "test:e2e": "node --test --test-concurrency=1 tools/tests/e2e/*.e2e.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "fzstd": "0.1.1",
    "hls.js": "1.6.16",
    "hyparquet": "1.32.0",
    "mediabunny": "1.56.1",
    "preact": "11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "wrangler": "4.151.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Bellaris-Weekly/bella-live-clip.git"
  }
}
